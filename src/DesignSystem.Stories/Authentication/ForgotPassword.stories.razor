@attribute [Stories("Authentication/Forgot Password")]
@using Microsoft.AspNetCore.Components
<Stories TComponent="ForgotPassword">
    @* Success is a soft navigation to the confirmation hop (no principal changes), so no driven story
       reaches it -- a real NavigateTo inside the canvas iframe resolves against the catalog's own routes
       (KNOWN-ISSUES.md). The succeeded state is the confirmation page itself, "Email Sent". *@
    <Story Name="Default">
        <Template>
            <LayoutView Layout="typeof(GateLayout)">
                <ForgotPassword @attributes="context.Args" />
            </LayoutView>
        </Template>
    </Story>
    <Story Name="Validation Errors">
        <Template>
            <StoryDriver @key="@("forgot-password-validation-errors")" Mode="StoryDriverMode.SubmitOnly">
                <LayoutView Layout="typeof(GateLayout)">
                    <ForgotPassword />
                </LayoutView>
            </StoryDriver>
        </Template>
    </Story>
    <Story Name="Email Sent">
        <Template>
            <ForgotPasswordConfirmation />
        </Template>
    </Story>
    <Story Name="Fault">
        <Template>
            <ScenarioScope Value="AuthenticationScenario.Fault">
                <StoryDriver @key="@("forgot-password-fault")" Mode="StoryDriverMode.FillAndSubmit">
                    <LayoutView Layout="typeof(GateLayout)">
                        <ForgotPassword />
                    </LayoutView>
                </StoryDriver>
            </ScenarioScope>
        </Template>
    </Story>
</Stories>
