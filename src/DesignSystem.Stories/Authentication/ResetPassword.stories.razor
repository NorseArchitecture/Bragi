@attribute [Stories("Authentication/Reset Password")]
@using Microsoft.AspNetCore.Components
<Stories TComponent="ResetPasswordForm">
    @* The form takes the emailed code as a plain parameter (the routable ResetPassword shim reads it from
       the query and redirects to Invalid Link when it is missing), so the form stories pass the synthetic
       code "story". Success is a soft navigation to the confirmation hop, so no driven story reaches it;
       the succeeded state is the confirmation page itself, "Password Reset". *@
    <Story Name="Default">
        <Template>
            <LayoutView Layout="typeof(GateLayout)">
                <ResetPasswordForm Code="story" @attributes="context.Args" />
            </LayoutView>
        </Template>
    </Story>
    <Story Name="Validation Errors">
        <Template>
            <StoryDriver @key="@("reset-password-validation-errors")" Mode="StoryDriverMode.SubmitOnly">
                <LayoutView Layout="typeof(GateLayout)">
                    <ResetPasswordForm Code="story" />
                </LayoutView>
            </StoryDriver>
        </Template>
    </Story>
    <Story Name="Invalid Link">
        <Template>
            <InvalidPasswordReset />
        </Template>
    </Story>
    <Story Name="Password Policy">
        <Template>
            <ScenarioScope Value="AuthenticationScenario.RegistrationValidation">
                <StoryDriver @key="@("reset-password-password-policy")" Mode="StoryDriverMode.FillAndSubmit">
                    <LayoutView Layout="typeof(GateLayout)">
                        <ResetPasswordForm Code="story" />
                    </LayoutView>
                </StoryDriver>
            </ScenarioScope>
        </Template>
    </Story>
    <Story Name="Invalid Token">
        <Template>
            <ScenarioScope Value="AuthenticationScenario.InvalidResetToken">
                <StoryDriver @key="@("reset-password-invalid-token")" Mode="StoryDriverMode.FillAndSubmit">
                    <LayoutView Layout="typeof(GateLayout)">
                        <ResetPasswordForm Code="story" />
                    </LayoutView>
                </StoryDriver>
            </ScenarioScope>
        </Template>
    </Story>
    <Story Name="Password Reset">
        <Template>
            <ResetPasswordConfirmation />
        </Template>
    </Story>
</Stories>
