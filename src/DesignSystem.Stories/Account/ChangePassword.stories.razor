@attribute [Stories("Account/Change Password")]
@using Microsoft.AspNetCore.Components
<Stories TComponent="ChangePassword">
    @* Default renders the routable page through ManageLayout; the catalog subject has a password, so
       PasswordPanel chooses the change form. The driver fills the current password with "aaaaaaaa" and the
       new one with "bbbbbbbb", which the form's differ-from-current rule needs. A change refreshes the
       sign-in, so "Changed" begins a session transition the catalog suppresses and records. *@
    <Story Name="Default">
        <Template>
            <LayoutView Layout="typeof(ManageLayout)">
                <ChangePassword @attributes="context.Args" />
            </LayoutView>
        </Template>
    </Story>
    <Story Name="Validation Errors">
        <Template>
            <StoryDriver @key="@("change-password-validation-errors")" Mode="StoryDriverMode.SubmitOnly">
                <ChangePasswordForm />
            </StoryDriver>
        </Template>
    </Story>
    <Story Name="Changed">
        <Template>
            <StoryDriver @key="@("change-password-changed")" Mode="StoryDriverMode.FillAndSubmit">
                <ChangePasswordForm />
            </StoryDriver>
        </Template>
    </Story>
    <Story Name="Incorrect Password">
        <Template>
            <ScenarioScope Value="AccountScenario.IncorrectPassword">
                <StoryDriver @key="@("change-password-incorrect-password")" Mode="StoryDriverMode.FillAndSubmit">
                    <ChangePasswordForm />
                </StoryDriver>
            </ScenarioScope>
        </Template>
    </Story>
    <Story Name="Password Policy">
        <Template>
            <ScenarioScope Value="AccountScenario.PasswordPolicy">
                <StoryDriver @key="@("change-password-password-policy")" Mode="StoryDriverMode.FillAndSubmit">
                    <ChangePasswordForm />
                </StoryDriver>
            </ScenarioScope>
        </Template>
    </Story>
    <Story Name="Fault">
        <Template>
            <ScenarioScope Value="AccountScenario.Fault">
                <StoryDriver @key="@("change-password-fault")" Mode="StoryDriverMode.FillAndSubmit">
                    <ChangePasswordForm />
                </StoryDriver>
            </ScenarioScope>
        </Template>
    </Story>
</Stories>
