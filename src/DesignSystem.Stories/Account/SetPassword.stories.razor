@attribute [Stories("Account/Set Password")]
@using Microsoft.AspNetCore.Components
<Stories TComponent="SetPassword">
    @* Default and Set run under ExternalOnly, the passwordless account that actually sets a password, so the
       page's PasswordPanel chooses the set form; Password Policy and Fault pin their own scenarios on the form.
       A set refreshes the sign-in, so "Set" begins a session transition the catalog suppresses and records. *@
    <Story Name="Default">
        <Template>
            <ScenarioScope Value="AccountScenario.ExternalOnly">
                <LayoutView Layout="typeof(ManageLayout)">
                    <SetPassword @attributes="context.Args" />
                </LayoutView>
            </ScenarioScope>
        </Template>
    </Story>
    <Story Name="Set">
        <Template>
            <ScenarioScope Value="AccountScenario.ExternalOnly">
                <StoryDriver @key="@("set-password-set")" Mode="StoryDriverMode.FillAndSubmit">
                    <SetPasswordForm />
                </StoryDriver>
            </ScenarioScope>
        </Template>
    </Story>
    <Story Name="Password Policy">
        <Template>
            <ScenarioScope Value="AccountScenario.PasswordPolicy">
                <StoryDriver @key="@("set-password-password-policy")" Mode="StoryDriverMode.FillAndSubmit">
                    <SetPasswordForm />
                </StoryDriver>
            </ScenarioScope>
        </Template>
    </Story>
    <Story Name="Fault">
        <Template>
            <ScenarioScope Value="AccountScenario.Fault">
                <StoryDriver @key="@("set-password-fault")" Mode="StoryDriverMode.FillAndSubmit">
                    <SetPasswordForm />
                </StoryDriver>
            </ScenarioScope>
        </Template>
    </Story>
</Stories>
