<Project Sdk="Microsoft.NET.Sdk.Razor">
	<PropertyGroup>
		<MD2RazorDefaultBaseClass>global::BlazingStory.Internals.Pages.MarkdownPageBase</MD2RazorDefaultBaseClass>
		<IsAotCompatible>false</IsAotCompatible>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="BlazingStory" Version="1.*-*" />
		<PackageReference Include="MD2RazorGenerator" Version="1.*">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
		<NorseRef Include="Abstractions.Components">
			<Repo>Asgard</Repo>
		</NorseRef>
		<!-- Deliberate direct references: FakeAuthenticationService implements AuthN.Services'
		     IAuthenticationService and speaks Contracts' Outcome/Problem vocabulary directly —
		     not just transitively through AuthN.Components.FluentUI. -->
		<NorseRef Include="Abstractions.Contracts">
			<Repo>Asgard</Repo>
		</NorseRef>
		<NorseRef Include="AuthN.Components.FluentUI">
			<Repo>Heimdall</Repo>
		</NorseRef>
		<NorseRef Include="AuthN.Services">
			<Repo>Heimdall</Repo>
		</NorseRef>
	</ItemGroup>
</Project>
