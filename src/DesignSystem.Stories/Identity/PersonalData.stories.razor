@attribute [Stories("Account/Personal Data")]
@using Microsoft.AspNetCore.Components
<Stories TComponent="PersonalData">
    @* Download is a self-disclosure call through FakeIdentityService, materialized client-side as
       PersonalData.json. The click changes nothing in the canvas -- it only saves a file -- so no driven
       "Download" story is staged: it would render identically to Default and save a file on every load. *@
    <Story Name="Default">
        <Template>
            <LayoutView Layout="typeof(ManageLayout)">
                <PersonalData @attributes="context.Args" />
            </LayoutView>
        </Template>
    </Story>
</Stories>
